    "landing_page_3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust the grid size to match your mood, from casual 4x4 to expert 12x12."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruh haline göre ızgara boyutunu ayarla, 4x4'ten uzman seviyesi 12x12'ye kadar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe die Rastergröße deiner Stimmung an – von entspanntem 4x4 bis Experten-12x12."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste la taille de la grille selon ton humeur, du 4x4 détente au 12x12 expert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el tamaño de la cuadrícula a tu estado de ánimo, desde un relajado 4x4 hasta un 12x12 experto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o tamanho da grade ao seu humor, do tranquilo 4x4 ao 12x12 de especialista."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola la dimensione della griglia secondo il tuo umore, dal rilassante 4x4 all’esperto 12x12."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирай размер сетки под настроение — от спокойного 4x4 до экспертного 12x12."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気分に合わせてグリッドサイズを調整。気軽な4x4からエキスパートの12x12まで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기분에 맞게 그리드 크기를 조절하세요. 가벼운 4x4부터 전문가용 12x12까지."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据心情调整网格大小，从轻松的 4x4 到专家级的 12x12。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依心情調整網格大小，從輕鬆的 4x4 到專家級的 12x12。"
          }
        }
      }
    },
