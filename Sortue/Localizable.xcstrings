    "how_to_play_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch tiles to arrange them into a perfect color gradient. The corners are fixed guides to reference you."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karelerin yerlerini değiştirerek mükemmel bir renk geçişi oluştur. Köşeler referans olmaları için sabit bırakılmışlardır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausche Kacheln, um einen perfekten Farbverlauf zu bilden. Die Ecken sind feste Orientierungspunkte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échange les tuiles pour former un dégradé de couleurs parfait. Les coins sont fixes et te servent de repères."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia las fichas para formar un degradado de color perfecto. Las esquinas están fijas y te sirven de referencia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque as peças de lugar para formar um degradê de cores perfeito. Os cantos são fixos e servem de referência."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scambia le tessere per comporre una sfumatura di colori perfetta. Gli angoli sono fissi e ti fanno da riferimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняй плитки местами, чтобы собрать идеальный цветовой градиент. Углы закреплены и служат ориентирами."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイルを入れ替えて、完璧なカラーグラデーションを作りましょう。四隅は固定された目印です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타일의 위치를 바꿔 완벽한 색상 그라데이션을 만드세요. 네 모서리는 고정된 기준점이에요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交换方块位置，拼出完美的颜色渐变。四个角是固定的参照点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交換方塊位置，拼出完美的顏色漸層。四個角是固定的參考點。"
          }
        }
      }
    },
