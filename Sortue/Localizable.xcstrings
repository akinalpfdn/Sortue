          "stringUnit" : {
            "state" : "translated",
            "value" : "גוררים משבצת כדי להחליף אותה באחרת. מציבים כל צבע במקומו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी टाइल को खींचकर दूसरी से बदलें। रंगों को सही जगह पर रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povuci bilo koju pločicu da je zamijeniš s drugom. Postavi boje na pravo mjesto."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzz egy csempét, hogy kicseréld egy másikkal. Tedd a színeket a helyükre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret ubin mana saja untuk menukarnya dengan ubin lain. Letakkan warna di tempat yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una tessera per scambiarla con un’altra. Metti i colori al posto giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイルをドラッグして別のタイルと入れ替え、色を正しい位置に並べましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타일을 드래그해 다른 타일과 바꾸세요. 색을 제자리에 놓으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret mana-mana jubin untuk menukarnya dengan jubin lain. Letakkan warna di tempat yang betul."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en rute for å bytte plass med en annen. Sett fargene på riktig sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een tegel om hem met een andere te wisselen. Zet de kleuren op de juiste plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij dowolny kafelek, aby zamienić go z innym. Ułóż kolory na właściwych miejscach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste qualquer peça para trocá-la com outra. Coloque as cores no lugar certo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrasta qualquer peça para a trocar com outra. Coloca as cores no sítio certo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage orice pătrat pentru a-l schimba cu altul. Pune culorile la locul lor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащи любую плитку, чтобы поменять её местами с другой. Расставь цвета по местам."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahni ľubovoľnú dlaždicu a vymeň ju s inou. Daj farby na správne miesto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
