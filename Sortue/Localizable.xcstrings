    "simple_experience" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أريد أن أقدم لك أبسط تجربة ممكنة، بلا إعلانات ولا مشتريات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vull oferir-te l’experiència més senzilla possible, sense anuncis ni monetització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chci ti nabídnout co nejjednodušší zážitek – bez reklam a bez placení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg vil give dig den enklest mulige oplevelse uden reklamer eller køb i appen."
