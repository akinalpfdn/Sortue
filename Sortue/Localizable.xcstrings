    "rate_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت تستمتع بـ Sortue، هل يمكنك تخصيص لحظة لتقييمها ودعمي؟ شكرًا لدعمك!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si gaudeixes de Sortue, podries dedicar un moment a valorar-lo i ajudar-me? Gràcies pel suport!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud tě Sortue baví, věnuj prosím chvilku jeho hodnocení a pomoz mi tím. Díky za podporu!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du nyder Sortue, vil du så bruge et øjeblik på at bedømme spillet og hjælpe mig? Tak for din støtte!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dir Sortue gefällt, würdest du dir kurz Zeit nehmen, es zu bewerten, und mich so unterstützen? Danke für deine Unterstützung!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν απολαμβάνεις το Sortue, θα αφιέρωνες λίγο χρόνο να το βαθμολογήσεις για να με βοηθήσεις; Ευχαριστώ για τη στήριξη!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you enjoy using Sortue, would you mind taking a moment to rate it and help me? Thanks for your support!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si disfrutas de Sortue, ¿te importaría dedicar un momento a valorarlo y ayudarme? ¡Gracias por tu apoyo!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si disfrutas Sortue, ¿podrías tomarte un momento para calificarlo y ayudarme? ¡Gracias por tu apoyo!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos pidät Sortuesta, voisitko käyttää hetken sen arvioimiseen ja auttaa minua? Kiitos tuestasi!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu aimes Sortue, pourrais-tu prendre un instant pour le noter et m’aider ? Merci pour ton soutien !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu aimes Sortue, pourrais-tu prendre un instant pour le noter et m’aider? Merci pour ton soutien!"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם Sortue מוצא חן בעיניכם, אפשר להקדיש רגע לדרג אותו ולעזור לי? תודה על התמיכה!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आपको Sortue पसंद है, तो क्या आप एक पल निकालकर इसे रेटिंग देकर मेरी मदद करेंगे? आपके सहयोग के लिए धन्यवाद!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako uživaš u igri Sortue, možeš li odvojiti trenutak da je ocijeniš i pomogneš mi? Hvala na podršci!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha tetszik a Sortue, szánnál rá egy percet, hogy értékeld, és ezzel segíts nekem? Köszönöm a támogatást!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau kamu menikmati Sortue, maukah kamu meluangkan waktu sebentar untuk memberi rating dan membantuku? Terima kasih atas dukunganmu!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ti piace Sortue, ti andrebbe di dedicare un attimo a valutarlo per aiutarmi? Grazie per il tuo supporto!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortueを気に入っていただけたら、少しだけお時間をいただいて評価で応援してもらえませんか？ご支援ありがとうございます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortue가 즐거우셨다면 잠시 시간을 내어 평가로 응원해 주시겠어요? 응원해 주셔서 감사합니다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda menikmati Sortue, sudikah anda meluangkan sedikit masa untuk menilainya dan membantu saya? Terima kasih atas sokongan anda!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du liker Sortue, vil du ta deg et øyeblikk til å vurdere spillet og hjelpe meg? Takk for støtten!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je van Sortue geniet, wil je dan even de tijd nemen om het te beoordelen en me zo te helpen? Bedankt voor je steun!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli lubisz Sortue, czy możesz poświęcić chwilę, by je ocenić i mi pomóc? Dzięki za wsparcie!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você está gostando do Sortue, poderia tirar um momento para avaliá-lo e me ajudar? Obrigado pelo apoio!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estás a gostar do Sortue, podias tirar um momento para o avaliar e ajudar-me? Obrigado pelo apoio!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă îți place Sortue, ai vrea să-ți faci un moment să-l evaluezi și să mă ajuți? Mulțumesc pentru sprijin!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если тебе нравится Sortue, найдёшь минутку, чтобы оценить игру и поддержать меня? Спасибо за поддержку!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak ťa Sortue baví, venuj prosím chvíľku jeho hodnoteniu a pomôž mi tým. Vďaka za podporu!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du gillar Sortue, vill du ta en stund och betygsätta spelet för att stötta mig? Tack för ditt stöd!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าคุณชอบ Sortue ช่วยสละเวลาสักครู่ให้คะแนนเพื่อสนับสนุนกันหน่อยได้ไหม? ขอบคุณสำหรับการสนับสนุน!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortue'yu kullanmaktan keyif alıyorsan, bir dakikanı ayırıp oy vererek bana destek olur musun? Desteğin için teşekkürler!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо тобі подобається Sortue, знайдеш хвилинку, щоб оцінити гру й підтримати мене? Дякую за підтримку!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn thích Sortue, bạn có thể dành chút thời gian đánh giá để ủng hộ mình không? Cảm ơn bạn đã ủng hộ!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你喜欢 Sortue，能否花一点时间评个分来支持我？感谢你的支持！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你喜歡 Sortue，能否花一點時間評分來支持我？感謝你的支持！"
