    "how_to_play_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل أماكن المربعات لترتيبها في تدرج لوني مثالي. الزوايا ثابتة لتكون مرجعًا لك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercanvia les fitxes per formar un degradat de colors perfecte. Les cantonades són fixes i et serveixen de referència."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prohazuj dlaždice tak, aby vytvořily dokonalý barevný přechod. Rohy jsou pevné a slouží jako vodítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt om på felterne for at danne en perfekt farveovergang. Hjørnerne ligger fast som pejlemærker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausche Kacheln, um einen perfekten Farbverlauf zu bilden. Die Ecken sind feste Orientierungspunkte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλαξε θέσεις στα πλακίδια για να σχηματίσεις μια τέλεια διαβάθμιση χρωμάτων. Οι γωνίες είναι σταθερές και σε βοηθούν ως σημεία αναφοράς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch tiles to arrange them into a perfect color gradient. The corners are fixed guides to reference you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia las fichas para formar un degradado de color perfecto. Las esquinas están fijas y te sirven de referencia."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia las fichas para formar un degradado de color perfecto. Las esquinas están fijas y te sirven de referencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda laattojen paikkoja ja muodosta täydellinen väriliukuma. Kulmat pysyvät paikallaan ja toimivat apuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échange les tuiles pour former un dégradé de couleurs parfait. Les coins sont fixes et te servent de repères."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échange les tuiles pour former un dégradé de couleurs parfait. Les coins sont fixes et te servent de repères."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחליפים בין המשבצות כדי לסדר אותן במעבר צבעים מושלם. הפינות קבועות ומשמשות כנקודות ייחוס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइलों की अदला-बदली करके उन्हें एक परफ़ेक्ट रंग ग्रेडिएंट में सजाएँ। कोने स्थिर हैं ताकि आपको संदर्भ मिले।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamjenjuj pločice dok ne nastane savršen prijelaz boja. Kutovi su fiksni i služe kao orijentiri."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cserélgesd a csempéket, hogy tökéletes színátmenetet alkossanak. A sarkok rögzítettek, és viszonyítási pontként szolgálnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukar ubin untuk menyusunnya menjadi gradasi warna yang sempurna. Sudut-sudutnya tetap sebagai panduan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scambia le tessere per comporre una sfumatura di colori perfetta. Gli angoli sono fissi e ti fanno da riferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイルを入れ替えて、完璧なカラーグラデーションを作りましょう。四隅は固定された目印です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타일의 위치를 바꿔 완벽한 색상 그라데이션을 만드세요. 네 모서리는 고정된 기준점이에요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukar jubin untuk menyusunnya menjadi gradien warna yang sempurna. Bucu-bucunya tetap sebagai panduan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt plass på rutene for å lage en perfekt fargeovergang. Hjørnene står fast og fungerer som referanse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissel tegels om ze in een perfect kleurverloop te leggen. De hoeken liggen vast als houvast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamieniaj kafelki, aby ułożyć idealny gradient kolorów. Rogi są nieruchome i służą jako punkty odniesienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque as peças de lugar para formar um degradê de cores perfeito. Os cantos são fixos e servem de referência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troca as peças de lugar para formar um gradiente de cores perfeito. Os cantos são fixos e servem de referência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbă pătratele între ele pentru a forma un gradient de culori perfect. Colțurile sunt fixe și îți servesc drept repere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняй плитки местами, чтобы собрать идеальный цветовой градиент. Углы закреплены и служат ориентирами."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymieňaj dlaždice, aby vytvorili dokonalý farebný prechod. Rohy sú pevné a slúžia ako orientačné body."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt plats på rutorna för att skapa en perfekt färgtoning. Hörnen är fasta och fungerar som riktmärken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สลับตำแหน่งช่องเพื่อเรียงให้เป็นไล่เฉดสีที่สมบูรณ์แบบ มุมทั้งสี่ถูกตรึงไว้เป็นจุดอ้างอิง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karelerin yerlerini değiştirerek mükemmel bir renk geçişi oluştur. Köşeler referans olmaları için sabit bırakılmışlardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Міняй плитки місцями, щоб скласти ідеальний кольоровий градієнт. Кути закріплені й слугують орієнтирами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi chỗ các ô để xếp thành một dải màu chuyển sắc hoàn hảo. Các góc được cố định để làm mốc tham chiếu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交换方块位置，拼出完美的颜色渐变。四个角是固定的参照点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交換方塊位置，拼出完美的顏色漸層。四個角是固定的參考點。"
          }
        }
      }
    },
