    "landing_page_2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد الألوان تنساب. حُلّ اللغز لتكشف التدرج المثالي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira com flueixen els colors. Resol el trencaclosques per revelar el degradat perfecte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduj, jak barvy plynou. Vyřeš hlavolam a odhal dokonalý přechod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se farverne flyde. Løs puslespillet for at afsløre den perfekte overgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh zu, wie die Farben fließen. Löse das Rätsel, um den perfekten Verlauf zu enthüllen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες τα χρώματα να κυλούν. Λύσε τον γρίφο για να αποκαλύψεις την τέλεια διαβάθμιση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch the colors flow. Solve the puzzle to reveal the perfect gradient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa cómo fluyen los colores. Resuelve el puzle para revelar el degradado perfecto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa cómo fluyen los colores. Resuelve el rompecabezas para revelar el degradado perfecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katso värien virtaavan. Ratkaise pulma ja paljasta täydellinen liukuma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde les couleurs s’écouler. Résous le puzzle pour révéler le dégradé parfait."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde les couleurs s’écouler. Résous le puzzle pour révéler le dégradé parfait."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צופים בצבעים זורמים. פותרים את החידה וחושפים את המעבר המושלם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रंगों को बहते देखें। पहेली हल करें और परफ़ेक्ट ग्रेडिएंट सामने लाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gledaj kako boje teku. Riješi zagonetku i otkrij savršen prijelaz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nézd, ahogy a színek áramlanak. Oldd meg a rejtvényt, és fedd fel a tökéletes átmenetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saksikan warna mengalir. Selesaikan teka-teki untuk mengungkap gradasi sempurna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda i colori scorrere. Risolvi il puzzle per svelare la sfumatura perfetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色の流れを感じながらパズルを解き、完璧なグラデーションを完成させましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색이 흐르는 걸 지켜보세요. 퍼즐을 풀어 완벽한 그라데이션을 완성하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saksikan warna mengalir. Selesaikan teka-teki untuk mendedahkan gradien yang sempurna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fargene flyte. Løs puslespillet for å avsløre den perfekte overgangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie de kleuren vloeien. Los de puzzel op en onthul het perfecte verloop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
