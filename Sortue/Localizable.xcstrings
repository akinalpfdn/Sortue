    "landing_page_1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag any tile to swap it with another. Put the colors in the right place."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir kareyi sürükleyerek diğeriyle değiştir. Renkleri doğru yerlerine koy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
